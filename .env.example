# Hosted vision (optional; secrets stay on the server)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Backend ----
VIRGO_MODEL=auto
VIRGO_FALLBACK_MODEL=llava:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30

# vLLM alternative backend
VLLM_ENABLED=false
VLLM_URL=http://localhost:8000/v1
VLLM_API_KEY=not-required
VLLM_MODEL=Qwen/Qwen2-VL-7B-Instruct-AWQ

# ---- Image preprocessing ----
VIRGO_MAX_IMAGE_SIZE=1280
VIRGO_MAX_IMAGE_BYTES=20971520

# ---- Pipeline ----
ENABLE_KV_CACHE=true
KV_CACHE_MAX_STAGES=3
GPU_MEMORY_FRACTION=0.85
VIRGO_NUM_PREDICT=4096
VIRGO_TEMPERATURE=0.1
VIRGO_TOP_P=0.9

# ---- Server ----
VIRGO_HOST=0.0.0.0
VIRGO_PORT=8000
CORS_ORIGINS=http://localhost:3000
SSE_RETRY_TIMEOUT=3000

# Auto-detects Ollama; hard forces DEMO if true
VIRGO_DEMO_MODE=false

# Public demo (disabled locally). Set all values before publishing.
VIRGO_PUBLIC_MODE=false
# Explicitly allow anonymous inspections while keeping budget and rate limits.
VIRGO_OPEN_ACCESS=false
VIRGO_ACCESS_CODE=
VIRGO_MAX_ANALYSES=10
VIRGO_DEMO_BUDGET_USD=0
# Fill with verified prices for ANTHROPIC_MODEL, USD per million tokens.
VIRGO_INPUT_USD_PER_M=0
VIRGO_OUTPUT_USD_PER_M=0
VIRGO_MAX_INPUT_TOKENS=12000
# Persistent single-instance storage; do not reset between deployments.
VIRGO_USAGE_DB=.runtime/usage.sqlite3
